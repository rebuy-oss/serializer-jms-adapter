{
    "name": "rebuy/serializer-jms-adapter",
    "description": "Adapter to use rebuy/serializer in place of jms/serializer.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Liip AG",
            "homepage": "http://www.liip.ch",
            "role": "Original Development (discontinued)"
        },
        {
            "name": "rebuy recommerce GmbH",
            "homepage": "https://www.rebuy.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "source": "https://github.com/rebuy-oss/serializer-jms-adapter",
        "issues": "https://github.com/rebuy-oss/serializer-jms-adapter/issues"
    },
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "jms/serializer": "^2.0 || ^3.0",
        "rebuy/serializer": "^1.0 || ^2.0 || ^3.0",
        "pnz/json-exception": "^1.0",
        "psr/log": "^1 | ^2 | ^3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^v3.72.0",
        "phpstan/phpstan": "^2.1.8",
        "phpstan/phpstan-phpunit": "^2.0.1",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.0.10"
    },
    "autoload": {
        "psr-4": {
            "Liip\\Serializer\\Adapter\\JMS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Liip\\Serializer\\Adapter\\JMS\\": "tests/"
        }
    },
    "replace": {
        "liip/serializer-jms-adapter": "*"
    },
    "scripts": {
        "cs:fix": "vendor/bin/php-cs-fixer fix -v",
        "cs:check": "vendor/bin/php-cs-fixer fix --dry-run -v",
        "phpstan": "vendor/bin/phpstan analyse --no-progress",
        "phpstan-tests": "vendor/bin/phpstan analyse --no-progress -c phpstan.tests.neon",
        "rector:check": "vendor/bin/rector process --dry-run",
        "rector:fix": "vendor/bin/rector process",
        "phpstan-all": [
            "@phpstan",
            "@phpstan-tests"
        ],
        "phpunit": "vendor/bin/phpunit",
        "ci": [
            "@cs-fixer",
            "@phpstan-all",
            "@phpunit"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
